{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Recess choose nudges",
	"type": "array",
	"items": {
		"allOf": [
			{
				"$ref": "./defs.schema.json#/definitions/base"
			}
		],
		"type": "object",
		"required": ["id", "icon", "color", "points", "prompt", "options"],
		"properties": {
			"prompt": {
				"type": "string",
				"minLength": 1
			},
			"options": {
				"type": "array",
				"minItems": 2,
				"maxItems": 4,
				"items": {
					"type": "object",
					"required": ["text", "color"],
					"additionalProperties": false,
					"properties": {
						"text": {
							"type": "string",
							"minLength": 1,
							"description": "Title Case"
						},
						"color": {
							"$ref": "./defs.schema.json#/definitions/color"
						},
						"icon": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			}
		}
	}
}
