{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Recess count nudges",
	"type": "array",
	"items": {
		"allOf": [
			{
				"$ref": "./defs.schema.json#/definitions/base"
			}
		],
		"type": "object",
		"required": [
			"id",
			"icon",
			"color",
			"points",
			"prompt",
			"unit",
			"validation_type",
			"validation_data"
		],
		"properties": {
			"prompt": {
				"type": "string",
				"minLength": 1
			},
			"unit": {
				"type": "string",
				"minLength": 1,
				"description": "Plural noun, e.g. birds"
			},
			"validation_type": {
				"const": "count"
			},
			"validation_data": {
				"$ref": "./defs.schema.json#/definitions/countValidation"
			}
		}
	}
}
