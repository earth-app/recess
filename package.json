{
  "private": true,
  "name": "@earth-app/recess",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate:ios": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build --dotenv .env.ios",
    "generate:android": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build --dotenv .env.android",
    "build:ios": "bun run generate:ios && bun run sync:version && bunx cap sync ios && bunx cap build ios",
    "build:android": "bun run generate:android && bun run sync:version && bunx cap sync android && bunx cap build android",
    "dev": "bunx nuxi dev --no-restart --public --port 3001",
    "dev:ios": "bun run dev -- --dotenv .env.ios",
    "dev:android": "bun run dev -- --dotenv .env.android",
    "dev:ios:native": "bash scripts/dev-ios.sh",
    "dev:android:native": "bash scripts/dev-android.sh",
    "dev:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run dev",
    "dev:ios:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run dev:ios",
    "dev:android:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run dev:android",
    "generate:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run generate",
    "generate:ios:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run generate:ios",
    "generate:android:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run generate:android",
    "build:ios:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run build:ios",
    "build:android:debug": "NUXT_PUBLIC_DEV_MODE=1 bun run build:android",
    "sync": "bunx cap sync",
    "sync:version": "bun run scripts/sync-version.ts",
    "sync:assets": "bun run capacitor-assets generate --ios --android && bash scripts/generate-ios-icon-variants.sh && bash scripts/generate-watch-icon.sh",
    "prettier": "bunx prettier --write .",
    "prettier:check": "bunx prettier --check .",
    "typecheck": "bunx vue-tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage --coverage.extension=.ts --coverage.extension=.vue",
    "build:test": "NUXT_PUBLIC_TEST_BUILD=1 NODE_OPTIONS='--max-old-space-size=8192' bunx nuxi build && echo 1 > dist/.test-build",
    "dev:test": "NUXT_PUBLIC_TEST_BUILD=1 bunx nuxi dev --no-restart --port ${RECESS_PORT:-3001} --host 127.0.0.1",
    "serve:test": "PORT=${RECESS_PORT:-3001} HOST=127.0.0.1 bun tests/e2e/utils/static-server.ts",
    "test:e2e": "RECESS_PORT=3003 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3003 PLAYWRIGHT_PROD=1 playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:webkit": "RECESS_PORT=3003 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3003 PLAYWRIGHT_PROD=1 playwright test --project=webkit",
    "test:e2e:serial": "RECESS_PORT=3003 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3003 PLAYWRIGHT_PROD=1 playwright test --project=chromium --project=mobile-chromium --workers=1 --retries=0",
    "maestro:ios": "bash scripts/maestro-ios.sh",
    "maestro:android": "bash scripts/maestro-android.sh",
    "maestro:eval": "MAESTRO_TAGS=eval bash scripts/maestro-${MAESTRO_PLATFORM:-ios}.sh",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:eval": "bun run tests/eval/run.ts",
    "test:eval:recommend": "bun run tests/eval/recommend.ts",
    "postinstall": "nuxt prepare",
    "prepare": "husky install"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/barcode-scanner": "^3.1.0",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capgo/capacitor-audio-recorder": "^8.2.6",
    "@capgo/capacitor-watch": "^8.1.1",
    "@codecov/nuxt-plugin": "^2.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/vue": "^8.8.15",
    "@ionic/vue-router": "^8.8.15",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.5.0",
    "@nuxtjs/ionic": "^1.0.2",
    "@paulmillr/qr": "^0.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "exifreader": "^4.41.3",
    "html5-qrcode": "^2.3.8",
    "luxon": "^3.7.2",
    "nuxt": "~4.4.8",
    "piexifjs": "^1.0.6",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@ionic/cli": "^7.2.1",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.62.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/bun": "^1.3.14",
    "@types/luxon": "^3.7.2",
    "@types/piexifjs": "^1.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "4.1.9",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,vue,css,md,json,xml,plist,storyboard,yml}": "prettier --write"
  }
}
